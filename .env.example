# Local Docker defaults. These credentials only work against the local
# compose services and must never be reused in production.
APP_NAME="Noise Monitor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8088
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=noise_monitor
DB_USERNAME=noise
DB_PASSWORD=noise-local-only

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noise-monitor@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Private S3-compatible object storage (RustFS locally, Laravel Cloud bucket in production).
AWS_ACCESS_KEY_ID=s3-local-only
AWS_SECRET_ACCESS_KEY=s3-local-only-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=noise-monitor
AWS_ENDPOINT=http://s3:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Endpoint used only to sign URLs handed to people's browsers. Locally the
# browser reaches the S3 service through the forwarded port; leave empty in production.
AWS_BROWSER_ENDPOINT=http://localhost:9100
# Endpoint used only to sign upload URLs handed to devices. Leave empty to use
# AWS_ENDPOINT. Set to a LAN-reachable address when a real Pi uploads to local S3.
AWS_DEVICE_ENDPOINT=

NOISE_DEFAULT_TIMEZONE=America/Chicago

# Optional: create the first owner automatically on first `docker compose up`
# (skipped once any user exists). Leave the password empty to have one
# generated and printed in the `init` service logs (`docker compose logs init`).
NOISE_INITIAL_OWNER_EMAIL=
NOISE_INITIAL_OWNER_PASSWORD=
NOISE_INITIAL_ACCOUNT=Household
NOISE_INITIAL_PROPERTY=Home

VITE_APP_NAME="${APP_NAME}"
